[
  {
    "gate": "integration",
    "command": "cargo.exe test --locked --offline --no-default-features --test user_windows --test user_windows_memory -- --nocapture --test-threads=1",
    "exit-code": 0,
    "log": "native-base-final-integration.log"
  },
  {
    "gate": "capi",
    "command": "cargo.exe test --locked --offline --no-default-features -p rax-capi -- --nocapture --test-threads=1",
    "exit-code": 0,
    "log": "native-base-final-capi.log"
  },
  {
    "gate": "full",
    "command": "cargo.exe test --locked --offline --no-default-features --lib -- --nocapture --test-threads=1",
    "exit-code": 101,
    "log": "native-base-final-full.log"
  },
  {
    "gate": "all-targets",
    "command": "cargo.exe check --locked --offline --no-default-features --all-targets",
    "exit-code": 0,
    "log": "native-base-final-all-targets.log",
    "environment": {
      "CARGO_INCREMENTAL": "0"
    },
    "recovery-record": "namespace-storage-recovery.json"
  }
]
